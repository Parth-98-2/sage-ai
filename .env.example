PORT=3000
DATABASE_URL=postgres://sage:sage@localhost:5432/sage_dev
TEST_DATABASE_URL=postgres://sage:sage@localhost:5432/sage_test

# Grounded answering (POST /answer). LLM_PROVIDER is ollama (default) or anthropic.
LLM_PROVIDER=ollama

# Ollama (local): the model must already be pulled, e.g. `ollama pull qwen2.5:7b`.
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_MS=300000

# Anthropic: credentials are resolved by the Anthropic SDK:
# ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile.
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
